{
  "name": "freecut",
  "version": "1.0.0",
  "description": "FreeCut — editor de vídeo gratuito com todos os recursos liberados",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/e2e.js",
    "dist": "electron-builder --win nsis",
    "icon": "electron build/make-icon.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.20",
    "electron": "^44.7.2",
    "electron-builder": "^25.1.8",
    "mp4-muxer": "^5.1.3",
    "playwright-core": "^1.49.1"
  },
  "build": {
    "appId": "com.freecut.editor",
    "productName": "FreeCut",
    "copyright": "FreeCut",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "asarUnpack": [],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "FreeCut"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FreeCut",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "FreeCut-Setup-${version}.${ext}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "compression": "normal"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/freecut-app/FreeCut"
  }
}